{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "dockerfile",
    "buildCommand": "echo 'Building from Dockerfile'"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT || npm start",
    "restartPolicyMaxRetries": 10
  }
}
