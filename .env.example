# SIGAIDA Campus Energy Environment Configuration
# Copy this file to .env and fill in your actual values
# Note: For production, use a secrets manager instead of .env files

# ============================================
# Backend Configuration
# ============================================
DATABASE_PATH=data_collection/campus_data.db
PYTHONUNBUFFERED=1
ENVIRONMENT=development

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# ============================================
# External API Keys
# ============================================
# OpenAQ API Key (for air quality data collection)
# Get it from: https://openaq.org/api
OPENAQ_KEY=your_openaq_api_key_here

# Google Earth Engine (for NDVI data collection)
# Follow GEE authentication instructions: https://developers.google.com/earth-engine/guides/python_install
GEE_PROJECT=sigaida-vegetation

# ============================================
# Deployment Configuration
# ============================================
# Set these when deploying to production
PORT=8000
FRONTEND_PORT=3000

# Railway.app specific
RAILWAY_ENVIRONMENT_NAME=production

# ============================================
# Optional: Email Alerts Configuration
# ============================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_app_password

# ============================================
# Optional: Monitoring & Analytics
# ============================================
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=info
